model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Assigned Products","Employees","Product Review Feedback","Product Reviews","Products","Product Model","Product Model Description","Product Description","ServerName","DatabaseName","DirectQuery to AS - product_insight"]

annotation __PBI_TimeIntelligenceEnabled = 1

ref table 'Assigned Products'
ref table Employees
ref table 'Product Review Feedback'
ref table 'Product Reviews'
ref table Products
ref table 'Product Model'
ref table 'Product Model Description'
ref table 'Product Description'
ref table PurchaseOrders
ref table Warehouse
ref table PurchaseOrderLines
ref table InventoryTransactions
ref table SupplierPerformance
ref table Suppliers
ref table Product
ref table Address
ref table ProductModel
ref table SalesOrderDetail
ref table ProductCategory
ref table Customer
ref table SalesOrderHeader
ref table ProductModelProductDescription
ref table ErrorLog
ref table ProductDescription
ref table BuildVersion
ref table CustomerAddress

ref cultureInfo en-US

